<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<h1>Reports & Analytics</h1><div class="cards"><div class="stat"><span>Active Beneficiaries</span><b>${stats.beneficiaries}</b></div><div class="stat"><span>Served This Month</span><b>${stats.served}</b></div><div class="stat"><span>Pending</span><b>${stats.pending}</b></div><div class="stat"><span>Rice Distributed</span><b>${stats.rice} KG</b></div></div>
<div class="panel"><h2>Distribution Records</h2><div class="table-wrap"><table><thead><tr><th>Receipt</th><th>Name</th><th>Card</th><th>Date</th><th>Rice</th><th>Wheat</th><th>Sugar</th><th>Dal</th></tr></thead><tbody><c:forEach var="d" items="${list}"><tr><td>${d.receipt_no}</td><td>${d.full_name}</td><td>${d.ration_card_number}</td><td>${d.distribution_date}</td><td>${d.rice_kg}</td><td>${d.wheat_kg}</td><td>${d.sugar_kg}</td><td>${d.dal_kg}</td></tr></c:forEach></tbody></table></div></div>
<button class="btn" onclick="window.print()">Print / Save PDF</button><%@ include file="../common/footer.jsp" %>