<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<h1>Stock Management</h1><div class="table-wrap"><table><thead><tr><th>Item</th><th>Opening</th><th>Received</th><th>Distributed</th><th>Remaining</th><th>Add Received</th></tr></thead><tbody><c:forEach var="s" items="${list}"><tr><td>${s.item_name}</td><td>${s.opening_stock}</td><td>${s.received_stock}</td><td>${s.distributed_stock}</td><td><b>${s.remaining_stock}</b></td><td><form class="inline" method="post" action="stock/update"><input type="hidden" name="item" value="${s.item_name}"><input class="mini" type="number" step="0.01" min="0" name="qty" required><button class="btn small">Add</button></form></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jsp" %>