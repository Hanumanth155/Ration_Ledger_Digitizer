<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<div class="panel-head"><h1>Announcements</h1></div><div class="grid2"><div class="panel"><h2>Publish Announcement</h2><form method="post" action="announcement/save">
<label>Title<input name="title" required></label><label>Description<textarea name="description" required></textarea></label><label>Type<select name="type"><option>GENERAL</option><option>RATION</option><option>IMPORTANT</option><option>STOCK</option></select></label><label>Published Date<input type="date" name="publishedDate" required></label><label>Expiry Date<input type="date" name="expiryDate"></label><label><input type="checkbox" name="published" checked> Publish now</label><button class="btn primary">Publish</button></form></div>
<div class="panel"><h2>Published Notices</h2><c:forEach var="a" items="${list}"><div class="notice"><span class="badge ${a.announcement_type}">${a.announcement_type}</span><div><b>${a.title}</b><small>${a.published_date}</small><p>${a.description}</p><form method="post" action="announcement/delete"><input type="hidden" name="id" value="${a.announcement_id}"><button class="link-btn danger-text">Delete</button></form></div></div></c:forEach></div></div><%@ include file="../common/footer.jsp" %>