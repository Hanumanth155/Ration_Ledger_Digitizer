<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<div class="panel-head"><div><h1>Monthly Ration Allocations</h1><p class="muted">Publish what will be distributed each month.</p></div><a class="btn primary" href="allocation">+ New Allocation</a></div>
<div class="table-wrap"><table><thead><tr><th>Month</th><th>Rice</th><th>Wheat</th><th>Sugar</th><th>Dal</th><th>Dates</th><th>Status</th><th></th></tr></thead><tbody><c:forEach var="a" items="${list}"><tr><td>${a.allocation_month}/${a.allocation_year}</td><td>${a.rice_kg}</td><td>${a.wheat_kg}</td><td>${a.sugar_kg}</td><td>${a.dal_kg}</td><td>${a.start_date} - ${a.end_date}</td><td><span class="status">${a.status}</span></td><td><a href="allocation?id=${a.allocation_id}">Edit</a></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jsp" %>