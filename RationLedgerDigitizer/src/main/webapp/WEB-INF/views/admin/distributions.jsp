<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<div class="panel-head"><h1>Distribution Records</h1><a class="btn primary" href="distribution">+ Record Collection</a></div><form class="filters"><input type="month" name="month" value="${param.month}"><select name="status"><option value="">All</option><option>COLLECTED</option><option>MISSED</option><option>CANCELLED</option></select><button class="btn">Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>Receipt</th><th>Beneficiary</th><th>Card</th><th>Month</th><th>Date</th><th>Rice</th><th>Wheat</th><th>Status</th></tr></thead><tbody><c:forEach var="d" items="${list}"><tr><td>${d.receipt_no}</td><td>${d.full_name}</td><td>${d.ration_card_number}</td><td>${d.allocation_month}/${d.allocation_year}</td><td>${d.distribution_date}</td><td>${d.rice_kg}</td><td>${d.wheat_kg}</td><td><span class="status">${d.status}</span></td></tr></c:forEach></tbody></table></div><%@ include file="../common/footer.jsp" %>