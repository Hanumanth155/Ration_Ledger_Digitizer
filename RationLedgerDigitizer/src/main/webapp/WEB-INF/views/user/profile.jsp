<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="../common/header.jsp" %><h1>My Profile</h1><div class="panel"><form method="post" class="form-grid"><label>Full Name<input value="${b.full_name}" readonly></label><label>Ration Card<input value="${b.ration_card_number}" readonly></label><label>Family Size<input value="${b.family_size}" readonly></label><label>Card Type<input value="${b.card_type}" readonly></label><label>Mobile<input name="mobile" value="${b.mobile}" required></label><label>Email<input type="email" name="email" value="${b.email}"></label><label class="wide">Address<textarea name="address">${b.address}</textarea></label><div class="wide"><button class="btn primary">Update Contact Details</button></div></form></div><%@ include file="../common/footer.jsp" %>