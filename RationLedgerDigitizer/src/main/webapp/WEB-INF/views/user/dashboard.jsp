<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ include file="../common/header.jsp" %>
<p class="muted">BENEFICIARY PORTAL / OVERVIEW</p><h1>Welcome, ${b.full_name}</h1><p class="muted">Your ration information and collection status.</p>
<div class="cards"><div class="stat"><span>Ration Card</span><b>${b.ration_card_number}</b></div><div class="stat"><span>Family Size</span><b>${b.family_size}</b></div><div class="stat"><span>Card Type</span><b>${b.card_type}</b></div><div class="stat"><span>Status</span><b>${b.status}</b></div></div>
<div class="grid2"><section class="panel"><h2>This Month's Ration</h2><c:choose><c:when test="${not empty a}"><div class="ration-grid"><div>Rice <b>${a.rice_kg} KG</b></div><div>Wheat <b>${a.wheat_kg} KG</b></div><div>Sugar <b>${a.sugar_kg} KG</b></div><div>Dal <b>${a.dal_kg} KG</b></div><div>${a.other_item} <b>${a.other_kg} KG</b></div></div><p><b>Schedule:</b> ${a.start_date} to ${a.end_date}, ${a.start_time} - ${a.end_time}</p><p><b>Location:</b> ${a.location}</p></c:when><c:otherwise><p>No published allocation currently.</p></c:otherwise></c:choose></section>
<section class="panel"><h2>Recent Announcements</h2><c:forEach var="x" items="${announcements}" begin="0" end="3"><div class="notice"><span class="badge ${x.announcement_type}">${x.announcement_type}</span><div><b>${x.title}</b><p>${x.description}</p></div></div></c:forEach></section></div>
<section class="panel"><div class="panel-head"><h2>Recent Collection</h2><a href="history">Full History</a></div><c:forEach var="h" items="${history}" begin="0" end="2"><div class="history-row"><span>${h.allocation_month}/${h.allocation_year}</span><span>${h.distribution_date}</span><span class="status">${h.status}</span><a href="receipt">Receipt</a></div></c:forEach></section><%@ include file="../common/footer.jsp" %>